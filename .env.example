AZURE_OPENAI_ENDPOINT=https://<aoai-name>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_SEARCH_ENDPOINT=https://<search-name>.search.windows.net
AZURE_SEARCH_INDEX=docs
# Auth: leave keys blank to use DefaultAzureCredential (`az login`, keyless; preferred for prod).
# Lab shortcut: fill keys (never commit .env). Get from Cloud Shell:
#   az cognitiveservices account keys list -n aoai<SUF> -g azure-ai-lab-rg --query key1 -o tsv
#   az search admin-key show --service-name srch<SUF> -g azure-ai-lab-rg --query primaryKey -o tsv
AZURE_OPENAI_API_KEY=
AZURE_SEARCH_API_KEY=
